# Hackathon review API only. Do not point this process at production DB/storage.
APP_ENV=review
DEMO_ACCOUNT_ENABLED=true
GOOGLE_LOGIN_ENABLED=false

HTTP_ADDR=:8080
CLIENT_ORIGIN=https://<review-api-origin>
DEV_CLIENT_ORIGIN=https://<review-api-origin>
ALLOW_EXPO_GO_REDIRECT=false

DB_HOST=<review-db-host>
DB_PORT=5432
DB_NAME=samurai_meet_demo
DB_USER=samurai_meet_demo_app
DB_PASSWORD=<review-db-password>
DB_SSLMODE=require
DB_SCHEMA=public

IMAGE_STORAGE_DIR=storage/demo-images
PROFILE_WRAPPING_PRIVATE_KEY_PEM=<review-profile-wrapping-private-key-pem>
PROFILE_WRAPPING_KEY_VERSION=demo-v1

JWS_SIGNING_KEY=<review-only-32-byte-base64url-key>
JWS_KEY_ID=demo-v1
JWS_ISSUER=samurai-meet-review-api
JWS_AUDIENCE=samurai-meet-review-mobile

GEMINI_API_KEY=<server-side-gemini-key>
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_PLACES_API_KEY=<server-side-places-key>

# Prefer a real moderation key for final rehearsal. Use this only for temporary
# smoke tests without real user data.
CHAT_MODERATION_DEV_FREE_MODE=false
