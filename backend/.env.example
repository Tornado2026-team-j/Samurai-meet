# HTTP サーバー
HTTP_ADDR=:8080
APP_ENV=development
# Set true only when the API should issue 24-hour Demo accounts. The server
# enforces Demo account scope, expiry, and Demo-only matching/chat boundaries.
DEMO_ACCOUNT_ENABLED=false
GOOGLE_LOGIN_ENABLED=true
# Expo Goのexp://復帰を許可する開発用スイッチ。本番運用ではfalse。
ALLOW_EXPO_GO_REDIRECT=false
DEV_CLIENT_ORIGIN=http://localhost:8081
# 本番WebクライアントのOrigin。productionではこの値を必須の正規originとして扱う。
CLIENT_ORIGIN=
# 本番で追加のWebクライアントを許可する場合のOrigin（カンマ区切り）。
# OAuth/CORSと、同じRP IDを使うWebAuthn related-originの許可にも使われる。
# 例: https://samurai-meet-expo-go-pre.disnana.com
ADDITIONAL_CLIENT_ORIGINS=

# メイン DB: PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=samurai_meet
DB_USER=samurai_meet_app
DB_PASSWORD=
# production requires TLS for a network DB. `disable` is accepted only when
# DB_HOST is loopback (127.0.0.1, ::1, or localhost) and the DB is not exposed.
DB_SSLMODE=disable
# PostgreSQL の名前空間。テーブル名は migration で固定し、この schema 内に作成する。
DB_SCHEMA=public

# 暗号化済みユーザー写真と、サーバー生成した思い出キャラクター画像の保存先。
# 撮影した元写真はクライアント暗号化した暗号文だけを保存する。
IMAGE_STORAGE_DIR=storage/images
# 暗号文のみをキャッシュする。平文画像・鍵はキャッシュしない。
IMAGE_CIPHERTEXT_CACHE_MAX_BYTES=268435456
IMAGE_CIPHERTEXT_CACHE_TTL_SECONDS=300
IMAGE_MAX_UPLOAD_BYTES=20971520
# プロフィール画像用の RSA 秘密鍵 PEM を Base64 化した値。開発用のみ。運用はKMS/Secret Managerで管理する。
PROFILE_WRAPPING_PRIVATE_KEY_PEM=
PROFILE_WRAPPING_KEY_VERSION=v1

# Google OAuth / OIDC（Google Cloud Console で発行）。開発ではGoogle Cloud
# Consoleに次のlocalhost callbackを登録し、本番ではHTTPS callbackへ上書きする。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# 募集内容の分類に使うGemini APIキー。モバイルアプリへは絶対に置かない。
# APIキー未設定時は募集プレビューの分類APIが503になり、公開へ進ませない。
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
# 案内後の思い出キャラクター画像生成に使うNano Banana 2 Liteモデル。
# 未設定時は gemini-3.1-flash-lite-image を使う。
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# チャット本文の送信前安全判定に使うOpenAI APIキー。モバイルアプリへは置かない。
# 未設定・タイムアウト・OpenAI障害時は fail-closed で送信を止め、アプリへ
# moderation_unavailable を返す。本文・OpenAI生応答は保存・ログ出力しない。
OPENAI_API_KEY=

# OpenAIキーを使わない確認用の一時モード。明示的にtrueにした場合だけ有効で、
# APIキーが環境に残っていてもこちらを優先し、高信頼の個人情報・外部連絡先等はローカル判定でも拒否します。
# productionでも明示設定すれば起動できますが、通常の本番運用では使わず、実データを投入しません。
# 有効時は起動警告を出し、正式運用前にfalseへ戻してOPENAI_API_KEYを設定します。
CHAT_MODERATION_DEV_FREE_MODE=false

# Passkey / WebAuthn。ローカル開発時は localhost を使用する。
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8081
WEBAUTHN_RP_DISPLAY_NAME=Samurai Meet

# JWS 署名鍵。開発用途のみ .env に設定し、運用では Secret Manager / KMS を使用する。
# 32 bytes のランダム値を Base64URL で設定する（32 bytes以外は拒否）。
JWS_SIGNING_KEY=
JWS_KEY_ID=v1
# 鍵ローテーション中に旧鍵を検証・復号するための許可リスト。
# 形式: key_id=base64url,key_id=base64url。active鍵は自動で含まれる。
JWS_VERIFY_KEYS=
JWS_ISSUER=samurai-meet-api
JWS_AUDIENCE=samurai-meet-mobile

# チャットのメッセージ送信レート制限（ユーザー単位のトークンバケット）。
# CHAT_SEND_BURST はバケット容量（正当なバーストを吸収する）。
# CHAT_SEND_REFILL_PER_MINUTE は補充レート＝持続的な送信上限（毎分）。
CHAT_SEND_BURST=15
CHAT_SEND_REFILL_PER_MINUTE=60
# 翻訳providerの利用枠（認証済みアカウント単位、PostgreSQL共有token bucket）。
# 1アカウントあたりの初期バースト、毎分の持続上限、同時provider呼び出し数。
CHAT_TRANSLATION_ACCOUNT_BURST=30
CHAT_TRANSLATION_ACCOUNT_REFILL_PER_MINUTE=30
CHAT_TRANSLATION_MAX_IN_FLIGHT=2
# メッセージ保持期間（日数）。作成からこの日数を過ぎたメッセージは
# 定期スイープで暗号文・nonce を消去し deleted_at を打ち、
# chat_message_deletions に監査行を1件残す。値は運用・法務決定で調整する。
CHAT_MESSAGE_RETENTION_DAYS=180

# Key-Bは端末のSecure Storage／Keychain／Keystoreで生成・保持する。
# サーバー側のKEY_B_WRAP_KEYやKey-B平文の設定は存在しない。
