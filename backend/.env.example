# HTTP サーバー
HTTP_ADDR=:8080
APP_ENV=development
DEV_CLIENT_ORIGIN=http://127.0.0.1:5173

# メイン DB: PostgreSQL。sqlite はローカル開発・CI テスト専用。
DB_DRIVER=postgres
# PostgreSQL 利用時の接続情報。IP アドレスまたはホスト名を設定する。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=samurai_meet
DB_USER=samurai_meet_app
DB_PASSWORD=
DB_SSLMODE=disable
# PostgreSQL の名前空間。テーブル名は migration で固定し、この schema 内に作成する。
DB_SCHEMA=public
# SQLite を使う開発・CI 時だけ指定する。SQLite は画像保存には使わない。
SQLITE_PATH=samurai-meet.db

# Google OAuth / OIDC（Google Cloud Console で発行）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=samuraimeet://auth/callback

# JWS 署名鍵。開発用途のみ .env に設定し、運用では Secret Manager / KMS を使用する。
# 32 bytes 以上のランダム値を Base64URL で設定する。
JWS_SIGNING_KEY=
JWS_ISSUER=samurai-meet-api
JWS_AUDIENCE=samurai-meet-mobile
