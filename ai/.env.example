# ---------------------------------------------------------------------------
# Samurai Meet AI service — environment variables
# Copy to `.env.local` for local development. Never commit real keys.
# ---------------------------------------------------------------------------

# OpenAI (server-only; used by lib/ai.ts — TODO(ai))
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Google Maps (server-only; used by lib/geo.ts — TODO(ai/infra))
# Needs Geocoding API + Places API enabled.
GOOGLE_MAPS_API_KEY=

# Supabase (service-role key is server-only — never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for generated monster images (public read).
SUPABASE_MONSTER_BUCKET=monsters

# Shared secret required on every /api/* call via the `x-ai-secret` header.
# Stand-in for real auth until Supabase Auth / Go JWS verification is added.
# If left empty, the check is skipped and a warning is logged (dev only).
AI_SERVICE_SHARED_SECRET=

# Max monster (re)generations per user.
MONSTER_REGEN_LIMIT=3
