# モバイルアプリとWeb版で共通に使うAPIのベースURL。
# ローカルの実機検証では、iPhoneから到達できるHTTPSの開発URLを指定する。
EXPO_PUBLIC_API_BASE_URL=https://samurai-meet.disnana.com/api/v1

# ローカルWebをローカルGo APIへ接続する場合は、上の値を次へ変更する。
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1
# バックエンド側もAPP_ENV=development、DEV_CLIENT_ORIGIN=http://localhost:8081、
# WEBAUTHN_RP_ID=localhost、WEBAUTHN_RP_ORIGIN=http://localhost:8081に揃える。

# OAuth callbackとネイティブ向けPasskey画面を配信するWeb Origin。
# 省略時はAPI_BASE_URLのoriginを使うため、ローカルAPIとの混在を防げる。
EXPO_PUBLIC_WEB_APP_ORIGIN=https://samurai-meet.disnana.com
