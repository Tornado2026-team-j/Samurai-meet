# Hackathon review build only. This must be the separated Demo API, not production.
EXPO_PUBLIC_API_BASE_URL=https://<review-api-origin>/api/v1
EXPO_PUBLIC_WEB_APP_ORIGIN=https://<review-api-origin>
EXPO_PUBLIC_DEMO_ACCOUNT_ENABLED=true
EXPO_PUBLIC_GOOGLE_LOGIN_ENABLED=false

# Keep disabled unless a native adapter is audited and included in the build.
EXPO_PUBLIC_MEETING_PROXIMITY_ENABLED=false
